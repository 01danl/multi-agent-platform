# AI Agent Platform — environment configuration
# Copy to backend/.env (local dev) or export before `docker compose up`.

# --- LLM providers (env-only; never stored in the database) ---------------
# At least one key is needed for real model calls.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Generic OpenAI-compatible endpoint (vLLM, LiteLLM, Together, ...)
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=

# Suggested model lists shown in the UI (comma-separated; free text allowed)
OPENAI_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini,gpt-4.1
OPENROUTER_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-sonnet,meta-llama/llama-3.3-70b-instruct
CUSTOM_MODELS=

# Deterministic fake provider (no external calls) for local demos and tests.
# NOT for production.
FAKE_PROVIDER_ENABLED=false

# --- Security --------------------------------------------------------------
# Session cookie signing / deployment secret. CHANGE IN PRODUCTION.
SECRET_KEY=dev-insecure-secret-key-change-me
SESSION_TTL_HOURS=336

# --- Storage ---------------------------------------------------------------
# SQLite for local dev; PostgreSQL for production (Phase 5).
DATABASE_URL=sqlite+aiosqlite:///./data/platform.sqlite
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite

# --- Runtime limits ----------------------------------------------------------
MAX_MODEL_CALLS_PER_RUN=40
GRAPH_RECURSION_LIMIT=120
RUN_TIMEOUT_SECONDS=600

# --- Misc --------------------------------------------------------------------
DEBUG=false
CORS_ORIGINS=http://localhost:5173
